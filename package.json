{
  "name": "uwsc-language-support",
  "displayName": "UWSC Language Support",
  "description": "UWSC language support for VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:uwsc"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "uwsc",
        "aliases": [
          "UWSC",
          "uwsc"
        ],
        "extensions": [
          ".uws"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "uwsc",
        "scopeName": "source.uwsc",
        "path": "./syntaxes/uwsc.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "uwsc",
        "path": "./snippets/uwsc.code-snippets"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run copy-files",
    "copy-files": "cp -r src/data out/",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.17.11",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.0.0"
  }
}
