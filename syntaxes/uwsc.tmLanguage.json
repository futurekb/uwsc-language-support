{
  "scopeName": "source.uwsc",
  "patterns": [
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#comments" },
    { "include": "#strings" }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.uwsc",
          "match": "\\b(IF|THEN|ELSE|ENDIF|FOR|TO|NEXT|WHILE|WEND|REPEAT|UNTIL|SELECT|CASE|DEFAULT|ENDSELECT|PROCEDURE|FUNCTION|ENDPROCEDURE|ENDFUNCTION|RETURN|EXIT|BREAK|CONTINUE|PRINT|CONST|DIM|PUBLIC|MODULE|ENDMODULE|CLASS|ENDCLASS|WITH|ENDWITH|TEXTBLOCK|ENDTEXTBLOCK|HASHTBL|TRY|FINALLY|ENDTRY|EXCEPT|OPTION|DEF_DLL|THREAD|CALL|LOGPRINT|STOPFORM|BALLOON|FUKIDASI|INPUT|MSGBOX|SLCTBOX)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.uwsc",
          "match": "\\b(TRUE|FALSE|NULL|EMPTY|NOTHING)\\b"
        },
        {
          "name": "variable.language.uwsc",
          "match": "\\b(G_[A-Z0-9_]+|PARAM_STR|ALL_[A-Z0-9_]+)\\b"
        },
        {
          "name": "constant.other.uwsc",
          "match": "\\b(COL_(RGB|R|G|B)|LEFT|RIGHT|MIDDLE|CLICK|DOWN|UP|ITM_[A-Z0-9_]+|SLCT_[A-Z0-9_]+|ACC_[A-Z0-9_]+|CLK_[A-Z0-9_]+|EXPLICIT|SAMESTR|OPTPUBLIC|OPTFINALLY|SPECIALCHAR|SHORTCIRCUIT|NOSTOPHOTKEY|TOPSTOPFORM|FIXBALLOON|DEFAULTFONT|POSITION|LOGPATH|LOGLINES|LOGFILE|DLGTITLE)\\b"
        }
      ]
    },
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.uwsc", "match": "//.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.uwsc",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.uwsc", "match": "\\\\." }
          ]
        }
      ]
    }
  }
}
